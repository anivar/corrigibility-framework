{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anivar.net/corrigibility/dpi/schema/corrigibility.json",
  "title": "DPI Corrigibility Assessment",
  "description": "Five-test corrigibility evaluation for Digital Public Infrastructure (v1.7)",
  "type": "object",
  "required": ["system_ref", "assessment_date", "tests"],
  "properties": {
    "system_ref": {
      "type": "string",
      "description": "Reference to infrastructure manifest system_name"
    },
    "assessment_date": {
      "type": "string",
      "format": "date"
    },
    "assessor": {
      "type": "object",
      "properties": {
        "organization": { "type": "string" },
        "methodology": { "type": "string" }
      }
    },
    "tests": {
      "type": "object",
      "required": ["EXIT", "CODE", "AUDIT", "GOVERN", "FORK"],
      "properties": {
        "EXIT": {
          "type": "object",
          "description": "Can affected subjects withdraw without penalty?",
          "properties": {
            "score": { "type": "number", "minimum": 0, "maximum": 1 },
            "mandatory_enrollment": { "type": "boolean" },
            "offline_alternative_exists": { "type": "boolean" },
            "penalty_severity": {
              "type": "string",
              "enum": ["none", "inconvenience", "economic", "essential_service_denial"]
            },
            "functional_exit_equivalence": { "type": "boolean" },
            "notes": { "type": "string" }
          }
        },
        "CODE": {
          "type": "object",
          "description": "Is the governing logic publicly inspectable?",
          "properties": {
            "score": { "type": "number", "minimum": 0, "maximum": 1 },
            "source_available": { "type": "boolean" },
            "license_permits_inspection": { "type": "boolean" },
            "build_reproducible": { "type": "boolean" },
            "specification_public": { "type": "boolean" },
            "notes": { "type": "string" }
          }
        },
        "AUDIT": {
          "type": "object",
          "description": "Can independent parties verify system behavior?",
          "properties": {
            "score": { "type": "number", "minimum": 0, "maximum": 1 },
            "independent_audit_permitted": { "type": "boolean" },
            "audit_reports_public": { "type": "boolean" },
            "real_time_monitoring_available": { "type": "boolean" },
            "notes": { "type": "string" }
          }
        },
        "GOVERN": {
          "type": "object",
          "description": "Do affected subjects have voice in governance?",
          "properties": {
            "score": { "type": "number", "minimum": 0, "maximum": 1 },
            "governance_body_exists": { "type": "boolean" },
            "user_representation": { "type": "boolean" },
            "binding_constraints_on_operator": { "type": "boolean" },
            "amendment_process_defined": { "type": "boolean" },
            "notes": { "type": "string" }
          }
        },
        "FORK": {
          "type": "object",
          "description": "Can the community fork if governance fails?",
          "properties": {
            "score": { "type": "number", "minimum": 0, "maximum": 1 },
            "legal_right_to_fork": { "type": "boolean" },
            "technical_artifacts_available": { "type": "boolean" },
            "data_portability": { "type": "boolean" },
            "practical_fork_feasible": { "type": "boolean" },
            "notes": { "type": "string" }
          }
        }
      }
    },
    "composite_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Geometric mean of five test scores"
    },
    "corrigibility_grade": {
      "type": "string",
      "enum": ["A", "B", "C", "D", "F"],
      "description": "A: ≥0.8, B: ≥0.6, C: ≥0.4, D: ≥0.2, F: <0.2"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "schema_version": { "type": "string", "const": "1.7" },
        "framework_paper": { "type": "string", "format": "uri" }
      }
    }
  }
}
