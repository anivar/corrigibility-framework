{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anivar.net/corrigibility/epi/schema/infrastructure.json",
  "title": "EPI Infrastructure Manifest",
  "description": "Operator disclosure for Epistemic Public Infrastructure corrigibility assessment (v1.7)",
  "type": "object",
  "required": ["system_name", "operator", "model_architecture", "deployment_context"],
  "properties": {
    "system_name": {
      "type": "string",
      "description": "Official name of the AI/learned system"
    },
    "operator": {
      "type": "object",
      "required": ["name", "jurisdiction"],
      "properties": {
        "name": { "type": "string" },
        "jurisdiction": { "type": "string" },
        "contact": { "type": "string", "format": "email" }
      }
    },
    "model_architecture": {
      "type": "object",
      "description": "LWD-R transparency layers",
      "properties": {
        "logic_layer": {
          "type": "object",
          "properties": {
            "architecture_documented": { "type": "boolean" },
            "architecture_url": { "type": "string", "format": "uri" }
          }
        },
        "weights_layer": {
          "type": "object",
          "properties": {
            "weights_available": { "type": "boolean" },
            "weights_url": { "type": "string", "format": "uri" },
            "license": { "type": "string" }
          }
        },
        "data_layer": {
          "type": "object",
          "properties": {
            "training_data_documented": { "type": "boolean" },
            "training_data_url": { "type": "string", "format": "uri" },
            "data_provenance_chain": { "type": "boolean" }
          }
        },
        "representation_layer": {
          "type": "object",
          "properties": {
            "embedding_space_documented": { "type": "boolean" },
            "category_boundaries_inspectable": { "type": "boolean" }
          }
        }
      }
    },
    "deployment_context": {
      "type": "object",
      "properties": {
        "domain": {
          "type": "string",
          "enum": ["welfare_eligibility", "judicial_risk", "credit_scoring", "healthcare_triage", "education_assessment", "employment_screening", "content_moderation", "other"]
        },
        "decision_authority": {
          "type": "string",
          "enum": ["advisory", "dispositive", "autonomous"]
        },
        "human_in_loop": { "type": "boolean" },
        "affected_population_size": { "type": "integer" }
      }
    },
    "action_boundary": {
      "type": "object",
      "description": "Deterministic envelope around stochastic inference",
      "properties": {
        "implemented": { "type": "boolean" },
        "boundary_logic_public": { "type": "boolean" },
        "boundary_logic_url": { "type": "string", "format": "uri" },
        "output_constrained_to_enum": { "type": "boolean" },
        "legal_citation_required": { "type": "boolean" }
      }
    },
    "workflow_capture_coefficient": {
      "type": "object",
      "description": "WCC = H(D_accept, D_human, θ)",
      "properties": {
        "measured": { "type": "boolean" },
        "wcc_value": { "type": "number", "minimum": 0, "maximum": 1 },
        "measurement_methodology": { "type": "string" }
      }
    },
    "compute_requirements": {
      "type": "object",
      "description": "For assessing Compute Capture risk",
      "properties": {
        "inference_compute_tflops": { "type": "number" },
        "training_compute_pflop_days": { "type": "number" },
        "minimum_viable_hardware": { "type": "string" }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "schema_version": { "type": "string", "const": "1.7" },
        "last_updated": { "type": "string", "format": "date" }
      }
    }
  }
}
